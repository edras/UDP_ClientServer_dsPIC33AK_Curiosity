        <mxCell id="rtt_bracket2" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;size=0.5;strokeColor=#009900;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="5" y="150" width="20" height="630" as="geometry" />
