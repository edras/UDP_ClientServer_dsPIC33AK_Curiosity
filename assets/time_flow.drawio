        <mxCell id="rtt_label2" value="&lt;b&gt;&lt;font color=&quot;#009900&quot;&gt;RTT&lt;br&gt;~422 us&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-60" y="440" width="70" height="40" as="geometry" />
        </mxCell>

        <!-- Savings annotation -->
        <mxCell id="savings_box" value="&lt;b&gt;&lt;font color=&quot;#009900&quot;&gt;Saved vs UDP: ~56 us (12%)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eliminated:&lt;br&gt;• IP header (20B) build/parse&lt;br&gt;• UDP header (8B) build/parse&lt;br&gt;• pbuf_alloc / pbuf_free&lt;br&gt;• UDP checksum&lt;br&gt;• IP routing lookup&lt;br&gt;• lwIP input demux chain" style="text;html=1;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="300" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend2" value="&lt;b&gt;Raw Ethernet Heartbeat (Mode 2)&lt;/b&gt;&lt;br&gt;EtherType: 0x88B5 (local experimental)&lt;br&gt;Payload: 1 byte (LED state)&lt;br&gt;Frame MCU builds: Eth(14) + 1 = 15B&lt;br&gt;On wire: 72 bytes (MAC pads to min)&lt;br&gt;SPI Clock: 20 MHz&lt;br&gt;Period: 500 ms&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#009900&quot;&gt;Green arrows = raw path (no lwIP)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;fontSize=10;" vertex="1" parent="1">
